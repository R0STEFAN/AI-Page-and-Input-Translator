{
  "manifest_version": 3,
  "name": "AI Page Translator",
  "version": "1.0.0",
  "description": "Розумний перекладач сторінок та виділеного тексту за допомогою Google Gemini та вбудованої офлайн-нейромережі.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://coarena.ai/*",
    "https://opencode.ai/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Page Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.bundle.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
